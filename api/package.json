{
  "name": "loandesk-api",
  "version": "1.0.0",
  "description": "LoanDesk API - secure Node.js + Express skeleton (MSSQL, hybrid RSA/AES-GCM transport encryption, RBAC)",
  "main": "app.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node cli.js migrate",
    "migrate:rollback": "node cli.js migrate:rollback",
    "migrate:status": "node cli.js migrate:status",
    "migrate:fresh": "node cli.js migrate:fresh",
    "make:migration": "node cli.js make:migration",
    "seed": "node cli.js seed",
    "seed:one": "node cli.js seed:one",
    "make:seeder": "node cli.js make:seeder",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "author": "ESH",
  "license": "ISC",
  "dependencies": {
    "@azure/identity": "^4.13.2",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "docx": "^9.5.1",
    "dotenv": "^17.2.3",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-fileupload": "^1.5.2",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "mssql": "^11.0.1",
    "nodemailer": "^10.2.1",
    "pdfkit": "^0.20.2",
    "request-ip": "^3.3.0",
    "swagger-ui-express": "^5.0.1",
    "validator": "^13.15.35",
    "xss": "^1.0.16"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.0.0"
  },
  "overrides": {
    "@azure/msal-node": "^7.1.1"
  }
