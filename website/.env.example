# Copy to `.env` for local development.
# LoanDesk API base URL, including /api. Demo requests are stored by the backend.
VITE_API_BASE_URL=http://localhost:3400/api

# Optional public contact address displayed on the website.
VITE_SALES_EMAIL=

# Full URL of the Angular application's login page. Set the live URL before deployment.
VITE_APP_LOGIN_URL=http://localhost:4200/login
