{
  "name": "loandesk-front",
  "version": "1.0.0",
  "description": "LoanDesk Angular client - structure mirrors the LoanDesk API (RSA+AES-GCM transport crypto, JWT auth, RBAC). UI built on Bootstrap 5 with the LoanDesk design system.",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.3",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "apexcharts": "^7.0.0",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "dompurify": "^3.4.17",
    "ng-apexcharts": "^3.1.0",
    "ngx-toastr": "^20.0.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@types/jest": "^30.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-preset-angular": "^17.0.1",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "ngx-toastr": {
      "@angular/core": "$@angular/core",
      "@angular/common": "$@angular/common"
    }
  }
}
